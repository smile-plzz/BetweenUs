# Choose explicitly. Local is for development only; Supabase is required on Vercel.
BETWEENUS_BACKEND=local
# Local PostgreSQL data persists here; use a separate directory for browser tests.
LOCAL_DATABASE_PATH=.local/betweenus
# Controlled adult text pilot only. Both members must also enable it in settings.
ENABLE_INTIMACY_PILOT=false
# For Supabase mode, set these server-only variables (no service-role key needed).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
APP_ORIGIN=http://localhost:3000
